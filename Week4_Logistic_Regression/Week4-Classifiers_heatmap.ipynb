   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from mlxtend.plotting import heatmap\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "data = pd.DataFrame(np.random.rand(10,5), columns=['A','B','C','D','E'])\n",
    "\n",
    "corr = data.corr()\n",
    "heatmap(corr.values, cmap='viridis')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
